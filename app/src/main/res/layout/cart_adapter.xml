<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_150sdp"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_5sdp"
        app:cardCornerRadius="@dimen/_13sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_140sdp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivImg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_140sdp"
                    android:src="@drawable/apple" />

                <LinearLayout
                    android:id="@+id/ll_discount"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:background="@drawable/bookmark"
                    android:scaleType="fitXY"
                    app:tint="@color/darkGreen">

                    <TextView
                        android:id="@+id/tvDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:maxLines="2"
                        android:padding="@dimen/_1sdp"
                        android:text=" 550 \noff "
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>


            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_toRightOf="@+id/ivImg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Baba Banshi red Kasmiri Apple"
                    android:textColor="@color/MatishBlack"
                    android:textSize="@dimen/_15sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/SalePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="\u20b9115"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/Mrp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_8sdp"

                        android:text="\u20b955"
                        android:textColor="#919191" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ll1"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:layout_marginRight="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:orientation="vertical">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


                    <LinearLayout
                        android:id="@+id/llUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/minus"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginLeft="@dimen/_8sdp"
                            android:background="@drawable/rounded_red"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/minus"
                            android:textColor="@color/white"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/quantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_8sdp"
                            android:padding="@dimen/_5sdp"
                            android:text="1"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/plus"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginLeft="@dimen/_8sdp"
                            android:background="@drawable/rounded_green"
                            android:padding="@dimen/_8sdp"

                            android:src="@drawable/add"
                            android:textColor="@color/white"
                            app:tint="@color/white" /></LinearLayout>

                        <ImageView
                            android:id="@+id/delete"
                             android:layout_alignParentRight="true"
                            android:layout_width="@dimen/_30sdp"
                             android:layout_marginRight="@dimen/_5sdp"
                            android:layout_height="@dimen/_30sdp"
                             android:layout_gravity="right"
                            android:padding="@dimen/_2sdp"
                            android:src="@drawable/ic_delete_icon"
                            app:tint="@color/red" />
</RelativeLayout>


                    <LinearLayout
                        android:id="@+id/llBuy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".9"
                            android:background="@drawable/rounded_stroke"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:text="ADD "
                            android:textColor="@color/red"
                            android:textStyle="bold" />


                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="0dp"
                            android:layout_weight=".25"
                            android:background="@drawable/rounded_plus"
                            android:gravity="center"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/add"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12sdp"
                            android:textStyle="bold"
                            app:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>


    </androidx.cardview.widget.CardView>


</LinearLayout>