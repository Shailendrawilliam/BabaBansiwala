<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
>

<androidx.cardview.widget.CardView
android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Dynamic Header (Red for Gave / Green for Got) -->
        <LinearLayout
            android:id="@+id/layoutEntryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D83430"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvEntryDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Record Transaction"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEntryDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Customer: John Doe"
                android:textColor="#FFCDD2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Transaction Type Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entry Type *"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgFundType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDebit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#D83430"
                    android:checked="true"
                    android:text="You Gave (Debit)"
                    android:textColor="#C62828"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbCredit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#2E7D32"
                    android:text="You Got (Credit)"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Amount Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Amount (₹) *"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEntryAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bgediteext"
                android:hint="Enter amount (e.g. 500)"
                android:inputType="numberDecimal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#212121"
                android:textColorHint="#BDBDBD"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Remark / Note Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Remark / Description"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEntryRemark"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bgediteext"
                android:hint="e.g. Cash, Bill #101, Goods sold"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#212121"
                android:textColorHint="#BDBDBD"
                android:textSize="14sp" />

            <!-- Optional Image Attachment Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attach Receipt / Bill Photo "
                    android:textColor="#424242"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(Optional)"
                    android:textColor="#757575"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardImageContainer"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#F9F9F9"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Image Preview -->
                    <ImageView
                        android:id="@+id/ivEntryImagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <!-- Placeholder Container -->
                    <LinearLayout
                        android:id="@+id/layoutImagePlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_camera"
                            app:tint="#888888" />

                        <TextView
                            android:id="@+id/tvImageStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tap to capture or upload photo (Optional)"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Clear / Remove Image Button -->
                    <ImageView
                        android:id="@+id/btnRemoveImage"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="6dp"
                        android:background="#80000000"
                        android:padding="4dp"
                        android:src="@drawable/ic_delete_icon"
                        android:visibility="gone"
                        app:tint="@color/white" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Buttons to pick image via Camera or Gallery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_grey_stroke"
                    android:drawableStart="@drawable/ic_camera"
                    android:drawablePadding="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Camera"
                    android:textColor="#333333"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSelectPhoto"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_grey_stroke"
                    android:drawableStart="@drawable/ic_document"
                    android:drawablePadding="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Gallery"
                    android:textColor="#333333"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCancelEntry"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btncancel"
                    android:text="Cancel"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveEntry"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_green"
                    android:text="Save Entry"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

</RelativeLayout>