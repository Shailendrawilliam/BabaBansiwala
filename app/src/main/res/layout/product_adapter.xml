<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_200sdp"
    android:orientation="vertical"
    android:layout_height="270dp"
    android:padding="@dimen/_10sdp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
         android:layout_margin="@dimen/_5sdp"
        app:cardCornerRadius="@dimen/_13sdp"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="@dimen/_140sdp">

                <ImageView
                    android:id="@+id/ivImg"
                    android:layout_width="match_parent"
                     android:layout_marginTop="@dimen/_5sdp"
                    android:layout_height="@dimen/_140sdp"
                    android:src="@drawable/apple" />
                <LinearLayout
                    android:layout_width="@dimen/_50sdp"
                    android:background="@drawable/bookmark"
                    android:scaleType="fitXY"
                    android:id="@+id/ll_discount"
                    android:layout_height="@dimen/_50sdp"
                    app:tint="@color/darkGreen">
                    <TextView
                        android:id="@+id/tvDiscount"
                        android:gravity="center"
                        android:maxLines="2"
                        android:padding="@dimen/_1sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/_12sdp"
                        android:text=" 550 \noff "
                        android:textColor="@color/white" />
                </LinearLayout>




            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_height="wrap_content"
                android:id="@+id/ll1"
                android:layout_toRightOf="@+id/ivImg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvtitle"
                    android:maxLines="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Baba Banshi red Kasmiri Apple"
                    android:textColor="@color/MatishBlack"
                    android:textSize="@dimen/_15sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/SalePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="\u20b9115"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/Mrp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_8sdp"

                        android:text="\u20b955"
                        android:textColor="#919191" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_below="@+id/ll1"
                android:id="@+id/ll2"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                     android:gravity="center"
                    android:visibility="gone"
                     android:id="@+id/llUpdate"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/minus"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginLeft="@dimen/_8sdp"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/minus"
                        app:tint="@color/white"
                        android:background="@drawable/rounded_red"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/quantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_8sdp"
                        android:padding="@dimen/_5sdp"
                        android:text="1"
                         android:textSize="@dimen/_14sdp"
                         android:textStyle="bold"
                        android:textColor="@color/grey" />

                    <ImageView
                        android:id="@+id/plus"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginLeft="@dimen/_8sdp"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/add"

                        android:background="@drawable/rounded_green"
                        android:textColor="@color/white"
                        app:tint="@color/white" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:id="@+id/llBuy"
                     android:visibility="visible"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="0dp"
                        android:layout_weight=".9"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_5sdp"
                        android:text="ADD "
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/rounded_stroke"
                        android:textColor="@color/red" />


                    <ImageView
                        android:layout_weight=".25"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="0dp"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/add"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textSize="@dimen/_12sdp"
                        android:background="@drawable/rounded_plus"
                        android:textColor="@color/white"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


    </androidx.cardview.widget.CardView>


</LinearLayout>